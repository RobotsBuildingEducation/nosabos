# Local-only overrides can go here.
# Shared Vite config is read from .env.

# Keep Tutor on the shipped Gemini Live path. This tracked override prevents a
# stale local OpenAI experiment flag from changing the provider unexpectedly.
VITE_TUTOR_REALTIME_PROVIDER=openai

# Keep local OAuth/onboarding data in the Firebase emulators. The DEV guard in
# firebaseResources.js prevents production builds from ever using this value.
VITE_USE_FIREBASE_EMULATORS=true
