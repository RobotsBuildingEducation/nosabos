# Local-only overrides can go here.
# Shared Vite config is read from .env.

# Keep Tutor on the Firebase AI Logic Gemini Live path. This local override
# prevents a stale OpenAI experiment flag from changing the provider.
VITE_TUTOR_REALTIME_PROVIDER=gemini
# Use Google AI Studio backend for Gemini Live (Gemini 3.1 Live Preview, bills to Google AI Studio)
VITE_GEMINI_LIVE_PROVIDER=google-ai
VITE_TUTOR_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Use live Firebase locally to test existing account progress and achievements.
# Set this to true to return to the local Firestore emulator.
VITE_USE_FIREBASE_EMULATORS=false
