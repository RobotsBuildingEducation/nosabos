{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/version.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/patreon/**",
        "function": { "region": "us-central1", "functionId": "patreonAuth" }
      },
      {
        "source": "/talkTurn",
        "function": { "region": "us-central1", "functionId": "talkTurn" }
      },
      {
        "source": "/tts",
        "function": { "region": "us-central1", "functionId": "tts" }
      },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "emulators": {
    "hosting": { "host": "0.0.0.0", "port": 5000 },
    "functions": { "host": "0.0.0.0", "port": 5001 },
    "firestore": { "host": "127.0.0.1", "port": 8080 }
  }
}
