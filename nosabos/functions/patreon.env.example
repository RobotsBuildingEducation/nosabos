# Non-secret Patreon OAuth configuration (copy to functions/.env)
PATREON_CLIENT_ID=replace-with-v2-client-id
PATREON_CAMPAIGN_ID=replace-with-campaign-id
PATREON_REDIRECT_URI=https://your-dev-or-production-host/api/patreon/callback
PATREON_APP_URL=https://your-dev-or-production-host

# Optional: comma-separated paid tier IDs. When omitted, any active paid
# membership in PATREON_CAMPAIGN_ID is accepted.
PATREON_ALLOWED_TIER_IDS=

# Optional session behavior
PATREON_SESSION_DAYS=30
PATREON_STATUS_CACHE_MINUTES=10
PATREON_STALE_GRACE_HOURS=6
PATREON_COOKIE_SECURE=true

# Secrets belong in functions/.secret.local for the emulator, or Firebase
# Secret Manager for deployments. Never expose these as VITE_* variables.
# PATREON_CLIENT_SECRET=
# PATREON_TOKEN_ENCRYPTION_KEY=
